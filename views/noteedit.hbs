<form action="/notes/save" method="post">

    <input type='hidden' name='docreate' value='{{#if docreate}}create{{else}}update{{/if}}'>

    <p>key:
        {{#if docreate}}
        <input type="text" name="notekey" value="">
        {{else}}
        {{#if note}}{{note.key}}{{/if}}
        <input type="hidden" name="notekey" value="{{#if note}}{{note.key}}{{/if}}">
        {{/if}}
    </p>

    <p>Title:
        <input type="text" name="title" value="{{#if note}}{{note.title}}{{/if}}">
    </p>

    <br>

    <textarea name="body" id="" cols="30" rows="10">
        {{#if note}}{{note.body}}{{/if}}
    </textarea>

    <br>

    <input type="submit" value="Submit">
</form>